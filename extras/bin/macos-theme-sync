#!/bin/bash
# Make the dock match the current theme's light/dark mode, then restart it.
# Runs from Omarchy's theme-set hook (~/.config/omarchy/hooks/theme-set.d/) on
# every theme change. Hyprland's window chrome (borders, title bars) follows
# the mode on its own because Omarchy reloads Hyprland when the theme changes.

SHARE="$HOME/.local/share/omarchy-macos"
COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"

mode=light
grep -q '^mode *= *"dark"' "$COLORS" 2>/dev/null && mode=dark

mkdir -p "$HOME/.config/nwg-dock-hyprland" "$HOME/.local/share/nwg-dock-hyprland/images"
cp "$SHARE/dock/style-$mode.css" "$HOME/.config/nwg-dock-hyprland/style.css"
cp "$SHARE/dock/images-$mode/"*.svg "$HOME/.local/share/nwg-dock-hyprland/images/"

if pgrep -x nwg-dock-hyprla >/dev/null; then
  setsid -f uwsm-app -- "$HOME/.local/bin/macos-dock" </dev/null >/dev/null 2>&1
fi
